---
// Footer.astro — shared footer (M6 §2.2)
// contentinfo landmark, nav landmarks per group, social links with visible
// labels, bottom-nav variant <480px (4 core links, 48px targets, aria-current).
import type { SiteConfig } from '../config/site';

interface Props {
  site: SiteConfig;
  currentPath?: string;
}

const { site, currentPath = '/' } = Astro.props;
const cleanPath = currentPath.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const h = href.replace(/\/$/, '') || '/';
  return h === cleanPath || (h !== '/' && cleanPath.startsWith(h));
};
const year = new Date().getFullYear();
// Bottom-nav core links (<480px): Home, Browse, Tools/Products, CTA
const bottomNav = [
  { href: '/', label: 'Home' },
  { href: '/all-articles/', label: 'Browse' },
  { href: '/about/', label: 'About' },
];
---

<footer class="border-t border-line bg-elevated text-ink-soft">
  <!-- Bottom nav: <480px only -->
  <nav class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-surface md:hidden" aria-label="Bottom navigation">
    <ul class="grid grid-cols-3">
      {bottomNav.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class="flex min-h-[48px] flex-col items-center justify-center gap-0.5 px-2 text-xs font-medium text-ink-soft transition hover:text-ink"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href={site.nav[0]?.href || '/'}
          class="flex min-h-[48px] flex-col items-center justify-center gap-0.5 px-2 text-xs font-semibold text-on-brand"
        >
          {site.name}
        </a>
      </li>
    </ul>
  </nav>

  <div class="mx-auto max-w-6xl px-4 pb-20 pt-8 md:pb-8">
    <div class="grid grid-cols-1 gap-8 text-sm md:grid-cols-4">
      <div>
        <div class="mb-3 flex items-center gap-2 font-heading text-lg font-bold text-ink">
          {site.logo ? <img src={site.logo.src} alt={site.logo.alt} class="h-6 w-6" /> : null}
          <span>{site.name}</span>
        </div>
        <p>{site.tagline}</p>
      </div>

      {site.footerColumns.map((col) => (
        <nav aria-label={col.heading}>
          <h4 class="mb-3 font-medium text-ink">{col.heading}</h4>
          <ul class="space-y-2">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="rounded-sm transition hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="mt-8 flex flex-col items-center gap-3 border-t border-line pt-6 text-center text-xs text-ink-soft md:flex-row md:justify-between">
      <div>
        &copy; {year} {site.name}. All rights reserved. <span class="opacity-70">{site.legalNote}</span>
      </div>
      {site.social.length > 0 ? (
        <ul class="flex gap-4">
          {site.social.map((s) => (
            <li>
              <a
                href={s.href}
                rel="noopener"
                target="_blank"
                class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-md transition hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring"
              >
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      ) : null}
    </div>
  </div>
</footer>
