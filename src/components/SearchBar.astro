---
// SearchBar.astro — shared search combobox (M6 §2.8)
// Combobox APG: input role=combobox aria-expanded aria-controls; listbox of
// results; arrow keys navigate; Escape closes. Results region role=region
// aria-label + aria-live=polite count. Visible label (placeholder is not the
// sole label).
// APG-clean listbox (Wyatt F2): each <li role=option> is a plain option with
// data-url — NO nested <a> (nested-interactive). Activation: Enter on the
// active option (aria-activedescendant) or mousedown on the option.
// NOTE: consumes a JSON search index at /search-index.json (emitted by
// build-toolchain-specialist's Pagefind or the astro build). Graceful empty
// state if index absent.
interface Props {
  placeholder?: string;
  indexUrl?: string;
}

const { placeholder = 'Search articles…', indexUrl = '/search-index.json' } = Astro.props;
const inputId = 'site-search-input';
const listboxId = 'site-search-listbox';
const resultsId = 'site-search-results';
---

<div class="relative w-full max-w-md">
  <label for={inputId} class="mb-1 block text-sm font-medium text-ink">Search</label>
  <input
    id={inputId}
    type="search"
    role="combobox"
    aria-expanded="false"
    aria-controls={listboxId}
    aria-autocomplete="list"
    aria-activedescendant=""
    autocomplete="off"
    placeholder={placeholder}
    data-index-url={indexUrl}
    class="w-full rounded-md border border-line bg-surface px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring"
  />
  <div
    id={resultsId}
    role="region"
    aria-label="Search results"
    aria-live="polite"
    class="sr-only"
  ></div>
  <ul
    id={listboxId}
    role="listbox"
    aria-label="Search results"
    class="absolute z-50 mt-1 hidden max-h-72 w-full overflow-auto rounded-md border border-line bg-elevated shadow-modal"
  ></ul>
</div>

<script>
  (function () {
    const input = document.getElementById('site-search-input');
    const listbox = document.getElementById('site-search-listbox');
    const resultsRegion = document.getElementById('site-search-results');
    if (!input || !listbox || !resultsRegion) return;

    let index = [];
    const indexUrl = input.dataset.indexUrl || '/search-index.json';

    fetch(indexUrl)
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error('no index'))))
      .then((data) => {
        index = Array.isArray(data) ? data : data.results || [];
      })
      .catch(() => {
        index = [];
      });

    let activeIndex = -1;

    function visibleItems(query) {
      const q = query.trim().toLowerCase();
      if (!q) return [];
      return index
        .filter((item) => (item.title + ' ' + (item.category || '')).toLowerCase().includes(q))
        .slice(0, 10);
    }

    function goTo(url) {
      if (url) window.location.href = url;
    }

    function render(query) {
      const items = visibleItems(query);
      listbox.innerHTML = '';
      if (items.length === 0) {
        const li = document.createElement('li');
        li.className = 'px-3.5 py-2.5 text-sm text-ink-soft';
        li.textContent = query.trim() ? 'No results found.' : 'Start typing to search.';
        listbox.appendChild(li);
        input.setAttribute('aria-expanded', 'true');
        resultsRegion.textContent = query.trim() ? 'No results found.' : '';
        activeIndex = -1;
        input.removeAttribute('aria-activedescendant');
        return;
      }
      items.forEach((item, i) => {
        const li = document.createElement('li');
        li.id = `search-result-${i}`;
        li.setAttribute('role', 'option');
        li.setAttribute('aria-selected', 'false');
        li.dataset.url = item.url || '#';
        li.className = 'cursor-pointer px-3.5 py-2.5 text-sm text-ink hover:bg-surface';
        const title = document.createElement('span');
        title.textContent = item.title;
        li.appendChild(title);
        if (item.category) {
          const span = document.createElement('span');
          span.className = 'ml-2 text-xs text-ink-soft';
          span.textContent = item.category;
          li.appendChild(span);
        }
        // mousedown (not click) so the input blur doesn't close the listbox first
        li.addEventListener('mousedown', (e) => {
          e.preventDefault();
          goTo(li.dataset.url);
        });
        listbox.appendChild(li);
      });
      input.setAttribute('aria-expanded', 'true');
      resultsRegion.textContent = `${items.length} result${items.length === 1 ? '' : 's'} found.`;
      activeIndex = -1;
      input.removeAttribute('aria-activedescendant');
    }

    function setActive(i) {
      const options = listbox.querySelectorAll('[role="option"]');
      if (options.length === 0) return;
      if (i < 0) i = 0;
      if (i >= options.length) i = options.length - 1;
      activeIndex = i;
      options.forEach((o, idx) => {
        const selected = idx === i;
        o.setAttribute('aria-selected', String(selected));
        o.classList.toggle('bg-surface', selected);
        if (selected) {
          input.setAttribute('aria-activedescendant', o.id);
          o.scrollIntoView({ block: 'nearest' });
        }
      });
    }

    input.addEventListener('input', () => {
      listbox.classList.remove('hidden');
      render(input.value);
    });

    input.addEventListener('focus', () => {
      listbox.classList.remove('hidden');
      render(input.value);
    });

    input.addEventListener('keydown', (e) => {
      const options = listbox.querySelectorAll('[role="option"]');
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        setActive(activeIndex + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActive(activeIndex - 1);
      } else if (e.key === 'Enter') {
        if (activeIndex >= 0 && options[activeIndex]) {
          e.preventDefault();
          goTo(options[activeIndex].dataset.url);
        }
      } else if (e.key === 'Escape') {
        listbox.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
        input.removeAttribute('aria-activedescendant');
      }
    });

    document.addEventListener('click', (e) => {
      if (!input.parentElement.contains(e.target)) {
        listbox.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
      }
    });
  })();
</script>
