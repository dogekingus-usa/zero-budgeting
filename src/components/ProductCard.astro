---
// ProductCard.astro — shared product card (M6 §2.10)
// CTA = real link to buy.stripe.com with descriptive accessible name
// (product + price context). Price/name as text (never images of text).
interface Props {
  name: string;
  price?: string;
  description?: string;
  href: string; // Stripe Payment Link
  image?: string;
  imageAlt?: string;
  badge?: string;
  features?: string[];
}

const { name, price, description, href, image, imageAlt = '', badge, features = [] } = Astro.props;
const ctaLabel = price ? `Buy ${name} — ${price}` : `Buy ${name}`;
---

<article class="flex h-full flex-col overflow-hidden rounded-lg border border-line bg-elevated">
  {image ? (
    <div class="aspect-video w-full overflow-hidden bg-surface">
      <img src={image} alt={imageAlt} loading="lazy" class="h-full w-full object-cover" />
    </div>
  ) : null}

  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-heading text-lg font-semibold text-ink">{name}</h3>
      {badge ? (
        <span class="rounded-full border border-line px-2.5 py-0.5 text-xs font-medium text-ink-soft">{badge}</span>
      ) : null}
    </div>

    {price ? <p class="text-xl font-bold text-ink">{price}</p> : null}
    {description ? <p class="text-sm text-ink-soft">{description}</p> : null}

    {features.length > 0 ? (
      <ul class="space-y-1.5 text-sm text-ink-soft">
        {features.map((f) => (
          <li class="flex items-start gap-2">
            <span aria-hidden="true" class="mt-0.5 text-success">✓</span>
            <span>{f}</span>
          </li>
        ))}
      </ul>
    ) : null}

    <a
      href={href}
      rel="noopener"
      target="_blank"
      aria-label={ctaLabel}
      class="mt-auto inline-flex min-h-[44px] items-center justify-center gap-2 rounded-md bg-brand px-6 py-2.5 text-sm font-semibold text-on-brand transition hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring"
    >
      {ctaLabel}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
