---
// CTA.astro — shared CTA (M6 §2.3)
// Renders as <a> (Stripe deep-link / internal) or <button> — never div-with-click.
// Verbatim `text` rendering (fixes [object Object] regression). Accessible name
// = visible text (2.5.3). On-brand contrast via token utilities.
// No onClick prop: inline handlers are CSP-hostile (Wyatt F3) — interactive
// behavior belongs to the consuming page's own <script>, not the component.
interface Props {
  href?: string;
  text?: string;
  variant?: 'primary' | 'secondary';
  size?: 'sm' | 'md' | 'lg';
  type?: 'link' | 'button';
  buttonType?: 'button' | 'submit';
  ariaLabel?: string;
}

const {
  href = '#',
  text = 'Get Started',
  variant = 'primary',
  size = 'md',
  type = 'link',
  buttonType = 'button',
  ariaLabel,
} = Astro.props;

// G4: every interactive target >= 44px (sm uses min-h-[44px] too — Wyatt F1).
const sizeClasses: Record<string, string> = {
  sm: 'px-4 py-2.5 text-xs min-h-[44px]',
  md: 'px-6 py-3 text-sm min-h-[44px]',
  lg: 'px-8 py-4 text-base min-h-[48px]',
};

// NOTE: primary = brand fill + on-brand text (verified pair per site tokens).
//       secondary = outline with ink text.
const variantClasses =
  variant === 'primary'
    ? 'bg-brand text-on-brand hover:opacity-90'
    : 'border border-line text-ink hover:bg-elevated';

const baseClasses =
  'inline-flex items-center justify-center gap-2 rounded-md font-semibold transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring';
const classNames = `${baseClasses} ${sizeClasses[size]} ${variantClasses}`;
---

{
  type === 'link' ? (
    <a href={href} class={classNames} aria-label={ariaLabel}>
      {text}
    </a>
  ) : (
    <button type={buttonType} class={classNames} aria-label={ariaLabel}>
      {text}
    </button>
  )
}
