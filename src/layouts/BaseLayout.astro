---
// BaseLayout.astro — ZeroBudgeting (Phase 1.2 shared library)
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { site } from '../config/site';

export interface Props {
  title: string;
  description: string;
  // M6 G9: explicit page H1 (40-70 chars, distinct from title). Legacy pages
  // omit it - their bodies carry their own H1 (the legacy fallback per spec).
  h1?: string;
  image?: string;
  canonical?: string;
  showNewsletter?: boolean;
}

const { title, description, h1, image, canonical, showNewsletter = true } = Astro.props;
const siteTitle = site.name;
const fullTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const canonicalUrl = canonical || `${site.url}${cleanPath}`;
const ogImage = image || `${site.url}/assets/og-image.svg`;
---

<!doctype html>
<html lang="en" class="theme-zerobudgeting">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="/crown-design-system.css" />

    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  </head>
  <body class="bg-surface text-ink font-body">
    <Header site={site} currentPath={Astro.url.pathname} />

    <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
      {h1 ? <h1 class="font-heading text-3xl font-bold text-ink sm:text-4xl">{h1}</h1> : null}
      <slot />
    </main>

    {showNewsletter ? <NewsletterForm site={site} /> : null}

    <Footer site={site} currentPath={Astro.url.pathname} />
  </body>
</html>
