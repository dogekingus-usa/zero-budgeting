---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-pay-off-debt-fast-using-the-debt-snowball-method.html?raw';

const title = "How to Pay Off Debt Fast Using the Debt Snowball Method | ZeroBudgeting.com";
const description = "Learn how to pay off debt fast using the debt snowball method. Step-by-step guide to eliminate credit cards, loans, and other debt with proven momentum-building strategies.";
const canonical = "https://zerobudgeting.com/how-to-pay-off-debt-fast-using-the-debt-snowball-method";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>