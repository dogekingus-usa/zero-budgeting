---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/student-loan-repayment-budget-2026.html?raw';

const title = "How to Budget for Student Loan Repayment in 2026: Complete Guide to Forgiveness, Income-Driven Plans, and Payoff Strategies | Zero Budgeting";
const description = "Student loan payments are back and complex. Learn how to budget for repayment using income-driven plans, forgiveness programs, and smart payoff strategies that fit your zero-based budget in 2026.";
const canonical = "https://zerobudgeting.com/student-loan-repayment-budget-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>