---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/all-articles.html?raw';

const title = "All Articles — Zero Budgeting";
const description = "Browse all 372 articles on Zero Budgeting";
const canonical = "https://zerobudgeting.com/all-articles.html";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
  </div>
</BaseLayout>