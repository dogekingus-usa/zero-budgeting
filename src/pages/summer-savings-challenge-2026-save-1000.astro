---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/summer-savings-challenge-2026-save-1000.html?raw';

const title = "Summer Savings Challenge 2026: Save $1,000+ by September with This Week-by-Week Plan | ZeroBudgeting.com";
const description = "Join the Summer Savings Challenge 2026 and save $1,000+ by September with a proven week-by-week plan. Free printable tracker, budget templates, and money-saving strategies for summer.";
const canonical = "https://zerobudgeting.com/summer-savings-challenge-2026-save-1000";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>