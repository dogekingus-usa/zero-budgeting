---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/pay-yourself-first-budgeting-method.html?raw';

const title = "The Pay Yourself First Budget: Why This One Rule Changes Everything | Zero Budgeting";
const description = "The pay yourself first budgeting method flips traditional budgeting on its head. Learn how saving first and spending what\u0027s left can transform your finances in 2026.";
const canonical = "https://zerobudgeting.com/pay-yourself-first-budgeting-method";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>