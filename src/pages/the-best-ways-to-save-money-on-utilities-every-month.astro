---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/the-best-ways-to-save-money-on-utilities-every-month.html?raw';

const title = "The Best Ways to Save Money on Utilities Every Month | zerobudgeting.com";
const description = "The Best Ways to Save Money on Utilities Every Month How to Slash Your Utility Bills with Zero Budgeting Techniques Living on a tight budget can";
const canonical = "https://zerobudgeting.com/the-best-ways-to-save-money-on-utilities-every-month";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>