---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/coast-fi-number-calculate-when-stop-saving-let-investments-grow-2026.html?raw';

const title = "The Coast FI Number: How to Calculate When You Can Stop Saving and Let Your Investments Grow";
const description = "Learn how to calculate your Coast FI number — the point where you can stop saving and let compound interest do the work. Complete guide with formulas, examples, and a step-by-step calculator.";
const canonical = "https://zerobudgeting.com/coast-fi-number-calculate-when-stop-saving-let-investments-grow-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>