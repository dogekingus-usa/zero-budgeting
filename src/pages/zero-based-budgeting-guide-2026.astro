---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/zero-based-budgeting-guide-2026.html?raw';

const title = "Zero-Based Budgeting: The Complete Guide for 2026 | ZeroBudgeting";
const description = "Master zero-based budgeting in 2026 with this complete guide. Learn how to allocate every dollar, eliminate waste, and take full control of your finances.";
const canonical = "https://zerobudgeting.com/zero-based-budgeting-guide-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>