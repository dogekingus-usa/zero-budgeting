---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-create-a-cash-flow-forecast-for-your-household-budget.html?raw';

const title = "How to Create a Cash Flow Forecast for Your Household Budget | zerobudgeting.com";
const description = "Creating a cash flow forecast is an essential step in managing your household budget effectively, especially when you\u0027re striving to live on zero budget o";
const canonical = "https://zerobudgeting.com/how-to-create-a-cash-flow-forecast-for-your-household-budget";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>