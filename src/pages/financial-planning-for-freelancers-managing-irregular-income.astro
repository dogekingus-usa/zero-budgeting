---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/financial-planning-for-freelancers-managing-irregular-income.html?raw';

const title = "Financial Planning for Freelancers Managing Irregular Income | zerobudgeting.com";
const description = "Financial Planning for Freelancers Managing Irregular Income Welcome to ZeroBudgeting.com! If you\u0027re a freelancer or entrepreneur with irregular incom";
const canonical = "https://zerobudgeting.com/financial-planning-for-freelancers-managing-irregular-income";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>