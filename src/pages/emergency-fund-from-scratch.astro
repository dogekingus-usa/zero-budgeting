---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/emergency-fund-from-scratch.html?raw';

const title = "How to Start an Emergency Fund From Scratch in 2026 — ZeroBudgeting.com";
const description = "Build an emergency fund from zero. Why emergency funds matter (with statistics on average emergency costs), how much to save (3-month minimum, 6-month recommended), step-by-step savings strategies, where to keep it (high-yield savings accounts), plus a free savings tracker template.";
const canonical = "https://zerobudgeting.com/emergency-fund-from-scratch";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>