---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/budgeting-for-mental-health-care-therapy-medication.html?raw';

const title = "Budgeting for Mental Health Care: How to Afford Therapy, Medication, and Wellness Without Breaking the Bank | Zero Budgeting";
const description = "Mental health care is essential, but it can be expensive. Learn practical strategies to budget for therapy, medication, and wellness while staying on track financially.";
const canonical = "https://zerobudgeting.com/budgeting-for-mental-health-care-therapy-medication";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>