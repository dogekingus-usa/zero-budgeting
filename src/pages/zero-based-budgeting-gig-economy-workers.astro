---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/zero-based-budgeting-gig-economy-workers.html?raw';

const title = "The Complete Guide to Zero-Based Budgeting for Gig Economy Workers | Zero Budgeting";
const description = "Master zero-based budgeting for gig economy workers, freelancers, and self-employed individuals. Handle irregular income, variable expenses, and tax planning with confidence.";
const canonical = "https://zerobudgeting.com/zero-based-budgeting-gig-economy-workers";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>