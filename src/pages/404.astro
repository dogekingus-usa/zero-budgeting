---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/404.html?raw';

const title = "404 — Page Not Found | Zero Budgeting";
const description = "Page not found on Zero Budgeting — browse our full article library instead.";
const canonical = "https://zerobudgeting.com/404";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
  </div>
</BaseLayout>