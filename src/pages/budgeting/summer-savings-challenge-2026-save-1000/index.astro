---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Budgeting';
const pageTitle = "Summer Savings Challenge 2026: Save $1,000+ by September with This Week-by-Week Plan | ZeroBudgeting.com";
const pageDesc = "Join the Summer Savings Challenge 2026 and save $1,000+ by September with a proven week-by-week plan. Free printable tracker, budget templates, and money-saving strategies for summer.";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">{pageTitle}</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">budgeting</span>
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">savings</span>
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">seasonal</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>{pageDesc}</p>
    </div>
  </article>
</BaseLayout>
