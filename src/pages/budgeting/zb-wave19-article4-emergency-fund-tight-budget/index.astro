---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Budgeting';
const pageTitle = "How to Build a 6-Month Emergency Fund on a Tight Budget: Step-by-Step Strategy for Financial Security";
const pageDesc = "A 6-month emergency fund reduces financial stress by 80%. Learn how to build one on any income using proven strategies, smart savings hacks, and ze...";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">{pageTitle}</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">budgeting</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>{pageDesc}</p>
    </div>
  </article>
</BaseLayout>
