---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/free-budget-templates-google-sheets.html?raw';

const title = "Best Free Google Sheets Budget Templates 2026 — Annual, Monthly, Envelope, Debt Payoff, Savings";
const description = "10 best free Google Sheets budget templates for 2026. Compare annual, monthly, envelope, bill tracker, debt payoff, and savings goal templates. Includes instructions to build your own from scratch with formulas and automation.";
const canonical = "https://zerobudgeting.com/free-budget-templates-google-sheets";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>