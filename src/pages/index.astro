---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="ZeroBudgeting — Personal Finance & Budgeting" description="Master your money with zero-based budgeting. Practical personal finance guides, tools, and strategies.">
  <section class="mx-auto max-w-6xl px-4 py-12">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-brand-500 mb-4">ZeroBudgeting</h1>
      <p class="text-xl text-gray-300 max-w-2xl mx-auto">
        Master your money with zero-based budgeting. Every dollar has a job.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <a href="/budgeting/" class="block rounded-xl border border-gray-600 bg-dark-700/50 p-6 hover:border-brand-500/50 hover:bg-dark-700 transition-all">
        <h2 class="text-lg font-semibold text-brand-500 mb-2">Budgeting</h2>
        <p class="text-sm text-gray-400">Zero-based budgeting strategies that work.</p>
      </a>
      <a href="/general/" class="block rounded-xl border border-gray-600 bg-dark-700/50 p-6 hover:border-brand-500/50 hover:bg-dark-700 transition-all">
        <h2 class="text-lg font-semibold text-brand-500 mb-2">Personal Finance</h2>
        <p class="text-sm text-gray-400">Savings, investing, and financial independence.</p>
      </a>
      <a href="/meme-coins/" class="block rounded-xl border border-gray-600 bg-dark-700/50 p-6 hover:border-brand-500/50 hover:bg-dark-700 transition-all">
        <h2 class="text-lg font-semibold text-brand-500 mb-2">Crypto Finance</h2>
        <p class="text-sm text-gray-400">Meme coin budgeting and crypto money management.</p>
      </a>
    </div>
  </section>
</BaseLayout>
