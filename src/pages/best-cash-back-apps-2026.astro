---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/best-cash-back-apps-2026.html?raw';

const title = "Best Cash Back Apps in 2026: Rakuten, Ibotta, Fetch, Dosh, TopCashback \u0026 Swagbucks Compared";
const description = "Compare the best cash back apps in 2026: Rakuten, Ibotta, Fetch Rewards, Dosh, TopCashback, and Swagbucks. See earnings potential, payout methods, and stacking strategies with real user data.";
const canonical = "https://zerobudgeting.com/best-cash-back-apps-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>