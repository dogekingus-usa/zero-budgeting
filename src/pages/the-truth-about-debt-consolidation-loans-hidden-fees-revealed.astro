---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/the-truth-about-debt-consolidation-loans-hidden-fees-revealed.html?raw';

const title = "The Truth About Debt Consolidation Loans Hidden Fees Revealed | zerobudgeting.com";
const description = "Debt consolidation loans are often presented as an easy solution to manage multiple debts by combining them into one loan with a lower interest rate. Ho...";
const canonical = "https://zerobudgeting.com/the-truth-about-debt-consolidation-loans-hidden-fees-revealed";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>