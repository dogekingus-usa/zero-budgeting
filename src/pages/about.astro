---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/about.html?raw';

const title = "About Zero Budgeting -- Master Your Money, Transform Your Life";
const description = "Zero Budgeting helps you take control of your finances with practical budgeting strategies and money management tips.";
const canonical = "https://zerobudgeting.com/about";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
  </div>
</BaseLayout>