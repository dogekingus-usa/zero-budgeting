---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/financial-planning-for-caregivers-support-aging-parents-2026.html?raw';

const title = "Financial Planning for Caregivers: How to Support Aging Parents Without Derailing Your Own Finances | Zero Budgeting";
const description = "Caring for aging parents is emotionally rewarding and financially challenging. Learn how to budget for caregiving costs without sacrificing your own financial future.";
const canonical = "https://zerobudgeting.com/financial-planning-for-caregivers-support-aging-parents-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>