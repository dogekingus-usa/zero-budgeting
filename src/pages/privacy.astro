---
import BaseLayout from '../layouts/BaseLayout.astro';
import body from '../bodies/privacy.html?raw';

const title = "Privacy Policy -- Zero Budgeting";
const description = "Privacy policy for Zero Budgeting. How we collect, use, and protect your data.";
const canonical = "https://zerobudgeting.com/privacy";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
  </div>
</BaseLayout>