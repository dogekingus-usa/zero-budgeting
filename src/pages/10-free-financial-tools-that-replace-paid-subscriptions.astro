---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/10-free-financial-tools-that-replace-paid-subscriptions.html?raw';

const title = "10 Free Financial Tools That Replace Paid Subscriptions | zerobudgeting.com";
const description = "When it comes to managing your finances, there are countless paid subscription tools available that can help you track spending, budget effectively, and ac";
const canonical = "https://zerobudgeting.com/10-free-financial-tools-that-replace-paid-subscriptions";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>