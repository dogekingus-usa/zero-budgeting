---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/the-complete-guide-to-building-an-emergency-fund-from-scratch.html?raw';

const title = "The Complete Guide to Building an Emergency Fund from Scratch | ZeroBudgeting.com";
const description = "Learn how to build an emergency fund from scratch step by step. Target amounts, saving strategies, where to keep it, and how to stay motivated.";
const canonical = "https://zerobudgeting.com/the-complete-guide-to-building-an-emergency-fund-from-scratch";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>