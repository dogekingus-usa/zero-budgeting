---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/zb-frugal-travel-budget-guide-2026.html?raw';

const title = "Frugal Travel Guide 2026: How to See the World on a Zero-Based Budget Without Sacrificing Experiences | ZeroBudgeting.com";
const description = "Travel the world without debt. Our 2026 frugal travel guide reveals flight hacks, cheap accommodation strategies, and budget tips that preserve experiences.";
const canonical = "https://zerobudgeting.com/zb-frugal-travel-budget-guide-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>