---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/understanding-your-credit-score-and-how-to-improve-it-fast.html?raw';

const title = "Understanding Your Credit Score and How to Improve It Fast | zerobudgeting.com";
const description = "Understanding Your Credit Score and How to Improve It Fast - ZeroBudgeting.com Understanding Your Credit Score and How to I";
const canonical = "https://zerobudgeting.com/understanding-your-credit-score-and-how-to-improve-it-fast";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>