---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/fire-movement-for-families-how-to-reach-financial-independence-with-kids-on-a-single-income.html?raw';

const title = "FIRE Movement for Families: How to Reach Financial Independence With Kids on a Single Income | ZeroBudgeting.com";
const description = "FIRE Movement for Families: How to Reach Financial Independence With Kids on a Single Income - Master your money with Zero Budgeting guides, tools, and strategies for financial freedom.";
const canonical = "https://zerobudgeting.com/fire-movement-for-families-how-to-reach-financial-independence-with-kids-on-a-single-income";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>