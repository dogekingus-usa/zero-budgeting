---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/minimalist-budgeting-complete-guide-spending-less-living-better-2026.html?raw';

const title = "Minimalist Budgeting: The Complete Guide to Spending Less and Living Better in 2026 | Zero Budgeting";
const description = "Discover minimalist budgeting — the method that helps you spend less on what you don\u0027t need so you can spend more on what matters. A complete guide for 2026.";
const canonical = "https://zerobudgeting.com/minimalist-budgeting-complete-guide-spending-less-living-better-2026";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>