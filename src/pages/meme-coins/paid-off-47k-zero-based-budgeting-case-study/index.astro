---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const cat = 'Meme Coins';
const pageTitle = "Case Study: How One Couple Paid Off $47,000 in 18 Months Using Zero-Based Budgeting";
const pageDesc = "Read how Mark and Lisa eliminated $47k in consumer debt in 18 months with zero-based budgeting. Real numbers, real strategies, and a system you can...";
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <article class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-8">
      <p class="text-sm text-brand-500 font-medium mb-2">{cat}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">{pageTitle}</h1>
      <time class="text-sm text-gray-500">2026</time>
      
      <div class="mt-3 flex gap-2 flex-wrap">
        <span class="text-xs bg-gray-700 text-gray-300 px-2 py-1 rounded">meme-coins</span>
      </div>
    </header>
    <div class="prose prose-invert prose-gray max-w-none">
      <p>{pageDesc}</p>
    </div>
  </article>
</BaseLayout>
