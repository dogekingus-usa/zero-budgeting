---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/the-complete-guide-to-building-generational-wealth-on-any-income.html?raw';

const title = "The Complete Guide to Building Generational Wealth on Any Income | zerobudgeting.com";
const description = "Building generational wealth on any income level might seem like an impossible dream to many. However, with strategic planning and a commitment to savin...";
const canonical = "https://zerobudgeting.com/the-complete-guide-to-building-generational-wealth-on-any-income";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>