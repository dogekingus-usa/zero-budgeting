---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-start-investing-with-little-money-2026-complete-beginners-guide.html?raw';

const title = "How to Start Investing with Little Money in 2026: Complete Beginner\u0027s Guide | ZeroBudgeting.com";
const description = "Learn how to start investing with little money in 2026. Complete beginner\u0027s guide covers micro-investing apps, index funds, ETFs, robo-advisors, and strategies to build wealth starting with just $50.";
const canonical = "https://zerobudgeting.com/how-to-start-investing-with-little-money-2026-complete-beginners-guide";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>