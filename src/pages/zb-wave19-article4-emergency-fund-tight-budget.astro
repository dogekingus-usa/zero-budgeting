---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/zb-wave19-article4-emergency-fund-tight-budget.html?raw';

const title = "How to Build a 6-Month Emergency Fund on a Tight Budget: Step-by-Step Strategy for Financial Security | Zero Budgeting";
const description = "A 6-month emergency fund reduces financial stress by 80%. Learn how to build one on any income using proven strategies, smart savings hacks, and zero-based budgeting principles in 2026.";
const canonical = "https://zerobudgeting.com/zb-wave19-article4-emergency-fund-tight-budget";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>