---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/how-to-negotiate-rent-and-save-hundreds-each-month.html?raw';

const title = "How to Negotiate Rent and Save Hundreds Each Month | zerobudgeting.com";
const description = "Negotiating rent can be a daunting task, but with the right approach, you can save hundreds of dollars each month without compromising on essential livi...";
const canonical = "https://zerobudgeting.com/how-to-negotiate-rent-and-save-hundreds-each-month";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>