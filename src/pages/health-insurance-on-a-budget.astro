---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import body from '../bodies/health-insurance-on-a-budget.html?raw';

const title = "Health Insurance on a Budget: Coverage Without Breaking the Bank | Zero Budgeting";
const description = "Find affordable health insurance even on a tight budget. Learn about subsidies, high-deductible plans, HSAs, and low-cost options that protect your health and wallet.";
const canonical = "https://zerobudgeting.com/health-insurance-on-a-budget";
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  publisher: { '@type': 'Organization', name: 'ZeroBudgeting' },
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="mx-auto max-w-4xl px-4 py-8">
    <Fragment set:html={body} />
    <div class="mt-12 text-center">
      <CTA href="/all-articles" text="Browse More Articles" variant="secondary" />
    </div>
  </article>
</BaseLayout>